      },
      {
        "id": "eq-chem-1",
        "type": "equation",
        "rawLatex": "\\text{N}_2\\text{(g)} + 3\\text{H}_2\\text{(g)} \\rightleftharpoons 2\\text{NH}_3\\text{(g)}, \\quad \\Delta H = -92.4\\text{ kJ/mol}",
        "ast": { "version": "1.0", "nodes": [] }
      },
      {
        "id": "p-chem-2",
        "type": "paragraph",
        "runs": [
          { "id": "t-c-2", "text": "Which combination of temperature and pressure maximizes the equilibrium yield of ammonia?" }
        ]
      }
    ],
    "options": [
