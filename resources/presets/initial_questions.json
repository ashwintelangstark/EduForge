        "id": "p-1",
        "type": "paragraph",
        "runs": [
          { "id": "t-1", "text": "A particle is projected from the ground with an initial velocity " },
          { "id": "t-2", "text": "u", "formatting": { "italic": true } },
          { "id": "t-3", "text": " at an angle " },
          { "id": "t-4", "text": "θ", "formatting": { "italic": true } },
          { "id": "t-5", "text": " with the horizontal. The maximum height " },
          { "id": "t-6", "text": "H", "formatting": { "bold": true, "italic": true } },
